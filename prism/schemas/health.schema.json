{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRISM health.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files",
    "symbols",
    "dead_code",
    "smell_counts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+$"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "complexity",
          "churn",
          "coverage",
          "centrality",
          "risk",
          "reasons",
          "smells"
        ],
        "properties": {
          "complexity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max",
              "total"
            ],
            "properties": {
              "max": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          },
          "churn": {
            "type": "integer"
          },
          "coverage": {
            "type": [
              "number",
              "null"
            ]
          },
          "centrality": {
            "type": "number"
          },
          "risk": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "smells": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "line",
                "detail",
                "symbol"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                },
                "symbol": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "complexity",
          "risk",
          "reasons"
        ],
        "properties": {
          "complexity": {
            "type": "integer"
          },
          "risk": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dead_code": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "file",
          "lines",
          "reason",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "likely",
              "possible"
            ]
          }
        }
      }
    },
    "smell_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    }
  }
}
