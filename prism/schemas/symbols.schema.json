{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRISM symbols.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "symbols"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+$"
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "module",
          "file",
          "lines",
          "signature",
          "doc",
          "visibility",
          "decorators",
          "parent",
          "calls",
          "called_by",
          "rank",
          "tokens_est"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "function",
              "class",
              "method"
            ]
          },
          "module": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "signature": {
            "type": "string"
          },
          "doc": {
            "type": "string"
          },
          "visibility": {
            "enum": [
              "public",
              "private"
            ]
          },
          "decorators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "calls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "called_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rank": {
            "type": "number",
            "minimum": 0
          },
          "tokens_est": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
