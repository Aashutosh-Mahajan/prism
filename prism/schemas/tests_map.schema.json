{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRISM tests_map.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_files",
    "by_symbol",
    "by_file"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+$"
    },
    "test_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "by_symbol": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "by_file": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
