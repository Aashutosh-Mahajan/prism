{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRISM blast_radius.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files",
    "symbols"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+$"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "top"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "top": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "top"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "top": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
