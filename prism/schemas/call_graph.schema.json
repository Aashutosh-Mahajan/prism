{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRISM call_graph.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edges",
    "rank",
    "stats"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+$"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "confidence",
          "line"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "rank": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edges",
        "unresolved_calls",
        "by_confidence"
      ],
      "properties": {
        "edges": {
          "type": "integer"
        },
        "unresolved_calls": {
          "type": "integer"
        },
        "by_confidence": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    }
  }
}
